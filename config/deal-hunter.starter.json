{
  "_comment": "Starter config used by deploy/install.sh. Deliberately has NO \"sources\" key: omitting it keeps the 15 built-in collectors. Copy config/deal-hunter.example.json to override the source set explicitly.",
  "data_dir": "/var/lib/deal-hunter",
  "log_level": "info",
  "interval": "30m",
  "jitter": "3m",
  "timezone": "Asia/Shanghai",
  "server": {
    "enabled": true,
    "bind": "127.0.0.1:8765"
  },
  "filter": {
    "require_offer": true,
    "max_age_hours": 336
  },
  "notify": {
    "feishu": {
      "enabled": true,
      "timezone": "Asia/Shanghai"
    },
    "openclaw": {
      "enabled": true,
      "relay": false
    },
    "daily": {
      "enabled": true,
      "at": "09:00",
      "min_score": 45,
      "max_items": 15
    },
    "urgent": {
      "enabled": true,
      "min_score": 90,
      "max_per_day": 1,
      "max_items": 5
    },
    "event": {
      "enabled": true,
      "lead_time": "45m",
      "late_grace": "15m",
      "max_per_day": 2,
      "min_score": 60,
      "max_items": 3
    },
    "console": false
  }
}
