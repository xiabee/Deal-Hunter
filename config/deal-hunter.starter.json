{
  "_comment": "Starter config used by deploy/install.sh. Deliberately has NO \"sources\" key: omitting it keeps the 15 built-in collectors. Copy config/deal-hunter.example.json to override the source set explicitly.",
  "data_dir": "/var/lib/deal-hunter",
  "log_level": "info",
  "interval": "30m",
  "jitter": "3m",
  "timezone": "Asia/Shanghai",
  "server": {
    "enabled": true,
    "bind": "127.0.0.1:8765"
  },
  "filter": {
    "min_score": 55,
    "require_offer": true,
    "max_age_hours": 336
  },
  "notify": {
    "feishu": {
      "enabled": true,
      "min_score": 62,
      "max_per_run": 6,
      "timezone": "Asia/Shanghai",
      "silent_hours": [0, 1, 2, 3, 4, 5, 6]
    },
    "openclaw": {
      "enabled": true,
      "relay": false
    },
    "digest": {
      "enabled": true,
      "every": "6h",
      "min_score": 45,
      "max_items": 12
    },
    "console": false
  }
}
