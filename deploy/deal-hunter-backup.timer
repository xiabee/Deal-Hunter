# Nightly, and again if the box was asleep when it was due.
# The zone is spelled out because the host runs UTC: a bare 04:30 would be
# 12:30 Beijing, i.e. midday, which is not "overnight".
#
#   sudo systemctl enable --now deal-hunter-backup.timer
#   systemctl list-timers deal-hunter-backup.timer

[Unit]
Description=每晚备份 Deal-Hunter 状态与配置

[Timer]
OnCalendar=*-*-* 04:30:00 Asia/Shanghai
RandomizedDelaySec=15m
Persistent=true
Unit=deal-hunter-backup.service

[Install]
WantedBy=timers.target
