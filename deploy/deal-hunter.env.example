# Deal-Hunter runtime environment. Copy to a file that stays out of git
# (chmod 600) and is referenced by systemd's EnvironmentFile.
#
# Everything here overrides the JSON config. Secrets and personal identifiers
# exist ONLY here — the config file can never carry them, and the CI secret
# scan keeps it that way.

# --- where state lives -------------------------------------------------------
DH_DATA_DIR=/var/lib/deal-hunter
DH_LOG_LEVEL=info

# --- cadence -----------------------------------------------------------------
DH_INTERVAL=30m
# 说明：这里没有「最低分」。历史上 DH_MIN_SCORE 看着像入库门槛，其实从未参与过
# 任何过滤（既不影响入库也不影响播报），已随本次改造删除。真正决定「进不进库」
# 的是 filter.require_offer 与噪音/过期判定；决定「日报里露不露脸」的是
# notify.daily.min_score。

# --- the one message a day ---------------------------------------------------
# 每天在 timezone（默认 Asia/Shanghai）的这个时刻发一份日报：把当前仍在效的
# 免费/优惠重列一遍，每条带收录时长与截止时间。当天没有在效的也照发，内容是
# 「今天没有」——这既回答了问题，也用掉了当天那一份。设为 0 关闭。
DH_DAILY_ENABLED=1
DH_DAILY_AT=09:00

# --- 限时事件提醒（开抢与到期）-------------------------------------------------
# 只提醒写得清楚的事件：解析不出「明确日期 + 明确时刻」就不发。每个事件至多一次，
# 一天最多两条。提醒精度等于采集间隔，所以 lead_time 要大于半个间隔才有意义。
DH_EVENT_ENABLED=1
DH_EVENT_LEAD_TIME=45m
# 到期前多久再提醒一次（同一张卡也管截止）；0s 表示只提醒开抢
DH_EVENT_EXPIRY_LEAD=3h
DH_EVENT_MIN_SCORE=60

# --- the only thing allowed to interrupt it ----------------------------------
# 分数不低于此值的发现可以当场插队一条，每天最多一条，其余全等日报。
# 设为 0 关掉插队，那就真的是一天只发一条。
DH_URGENT_ENABLED=1
DH_URGENT_MIN_SCORE=90

# --- path 1a: direct push via a Feishu group custom bot -----------------------
# 群设置 → 群机器人 → 自定义机器人 → 复制 Webhook 地址；安全设置勾选「签名校验」。
DH_FEISHU_ENABLED=1
DH_FEISHU_WEBHOOK=__PASTE_THE_BOT_WEBHOOK_URL_HERE__
DH_FEISHU_SECRET=__PASTE_THE_SIGNING_SECRET_HERE__

# --- path 1b: direct push via a Feishu application identity -------------------
# 不需要新建群机器人：用一个自建应用（需 im 消息发送权限）直接投给某人/某群。
# App ID 是公开标识；App Secret 与 webhook 一样只能待在这个 0600 文件里。
# 两者配好且没有 webhook 时自动走这条路径。
# DH_FEISHU_APP_ID=cli_<你的应用ID>
# DH_FEISHU_APP_SECRET=__PASTE_THE_APP_SECRET_HERE__
# DH_FEISHU_RECEIVE_ID=ou_xxxxx            # 或 oc_xxxxx 群会话 id
# DH_FEISHU_RECEIVE_ID_TYPE=open_id        # open_id|union_id|user_id|email|chat_id

# --- path 2: relay through an existing OpenClaw install ----------------------
# Uses the assistant's own Feishu connection; no new credentials are created.
# When the service user differs from the OpenClaw user, point DH_OPENCLAW_COMMAND
# at a wrapper (see deploy/sudoers-deal-hunter) instead of the CLI directly.
DH_OPENCLAW_RELAY=0
DH_OPENCLAW_CHANNEL=feishu
DH_OPENCLAW_COMMAND=openclaw
DH_OPENCLAW_TARGET=__PASTE_CHAT_ID_EG_chat_123456__

# --- read-only status API ----------------------------------------------------
# Keep this on loopback, or on the machine's private mesh address
# (e.g. a Tailscale CGNAT address). Binding a public interface is refused by
# config validation unless DH_ALLOW_PUBLIC_BIND=1 is set deliberately.
DH_SERVER_ENABLED=1
DH_SERVER_BIND=127.0.0.1:8765

# --- break-glass override, leave unset in normal operation -------------------
# DH_ALLOW_PUBLIC_BIND=1
