# Deal-Hunter runtime environment. Copy to a file that stays out of git
# (chmod 600) and is referenced by systemd's EnvironmentFile.
#
# Everything here overrides the JSON config. Secrets and personal identifiers
# exist ONLY here — the config file can never carry them, and the CI secret
# scan keeps it that way.

# --- where state lives -------------------------------------------------------
DH_DATA_DIR=/var/lib/deal-hunter
DH_LOG_LEVEL=info

# --- cadence and thresholds --------------------------------------------------
DH_INTERVAL=30m
DH_MIN_SCORE=62

# --- path 1: direct push via a Feishu group custom bot ------------------------
# 群设置 → 群机器人 → 自定义机器人 → 复制 Webhook 地址；安全设置勾选「签名校验」。
DH_FEISHU_ENABLED=1
DH_FEISHU_WEBHOOK=__PASTE_THE_BOT_WEBHOOK_URL_HERE__
DH_FEISHU_SECRET=__PASTE_THE_SIGNING_SECRET_HERE__

# --- path 2: relay through an existing OpenClaw install ----------------------
# Uses the assistant's own Feishu connection; no new credentials are created.
# When the service user differs from the OpenClaw user, point DH_OPENCLAW_COMMAND
# at a wrapper (see deploy/sudoers-deal-hunter) instead of the CLI directly.
DH_OPENCLAW_RELAY=0
DH_OPENCLAW_CHANNEL=feishu
DH_OPENCLAW_COMMAND=openclaw
DH_OPENCLAW_TARGET=__PASTE_CHAT_ID_EG_chat_123456__

# --- read-only status API ----------------------------------------------------
# Keep this on loopback, or on the machine's private mesh address
# (e.g. a Tailscale CGNAT address). Binding a public interface is refused by
# config validation unless DH_ALLOW_PUBLIC_BIND=1 is set deliberately.
DH_SERVER_ENABLED=1
DH_SERVER_BIND=127.0.0.1:8765

# --- break-glass override, leave unset in normal operation -------------------
# DH_ALLOW_PUBLIC_BIND=1
